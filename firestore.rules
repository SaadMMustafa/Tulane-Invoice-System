rules_version = '2';

// قواعد أمان Firestore لنظام فواتير TULANE
// المدير: amnytalmhdy@gmail.com — صلاحيات كاملة.
// العضو المعتمد: مستند له في accessRequests بالحقل approved == true.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'amnytalmhdy@gmail.com';
    }

    function isApproved() {
      return request.auth != null
        && (
          isAdmin()
          || (
            exists(/databases/$(database)/documents/accessRequests/$(request.auth.uid))
            && get(/databases/$(database)/documents/accessRequests/$(request.auth.uid)).data.approved == true
          )
        );
    }

    // طلبات الدخول: كل مستخدم ينشئ طلبه الخاص (معلّقًا)، والمدير يوافق أو يرفض.
    match /accessRequests/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && (
        (request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.approved == false
          && request.resource.data.status == 'pending')
        || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // إعدادات النظام العامة: القراءة للمعتمدين، والكتابة للمدير فقط.
    match /appConfig/settings {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // عدّاد أرقام الفواتير: يُحدَّث داخل معاملة إنشاء الفاتورة بواسطة أي معتمد.
    match /appConfig/invoiceCounter {
      allow read: if isApproved();
      allow create, update: if isApproved()
        && request.resource.data.nextNumber is number
        && request.resource.data.nextNumber >= 1;
      allow delete: if false;
    }

    // المنتجات: الإنشاء للمعتمدين (يدويًا أو تلقائيًا من الفاتورة).
    // التعديل: المدير بحرية، والعضو المعتمد فقط حقول المخزون/السعر التي تعدلها معاملة الفاتورة.
    match /products/{productId} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.price is number;
      allow update: if isAdmin()
        || (isApproved()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stock', 'price', 'priceHistory']));
      allow delete: if isAdmin();
    }

    // العملاء: الإنشاء للمعتمدين، والتعديل والحذف للمدير فقط.
    match /customers/{customerId} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update, delete: if isAdmin();
    }

    // الفواتير: الإنشاء للمعتمدين (برقمهم كمنشئ)، والتعديل والحذف للمدير فقط.
    match /invoices/{invoiceId} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.total is number;
      allow update, delete: if isAdmin();
    }

    // بيانات المستخدم القديمة (الترحيل): كل مستخدم يصل إلى مساره فقط.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
